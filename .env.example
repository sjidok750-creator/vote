# 데이터베이스 (SQLite 파일 경로)
# 로컬 개발: 프로젝트 폴더의 dev.db 사용
DATABASE_URL="file:./dev.db"
# 운영(영구 디스크) 예시: DATABASE_URL="file:/data/prod.db"

# 익명 해시용 비밀 솔트 — 운영 시 반드시 임의의 긴 값으로 변경하세요.
VOTE_SALT="change-this-to-a-long-random-string"

# 서비스 절대주소 (OG 이미지/공유 링크용). Render 는 RENDER_EXTERNAL_URL 을 자동 제공하므로 보통 생략 가능.
# NEXT_PUBLIC_BASE_URL="https://your-app.onrender.com"

# (선택) 카카오톡 '피드' 카드 공유용 JavaScript 키.
# 없어도 동작합니다(휴대폰 기본 공유/링크 복사로 폴백). 카카오톡 링크 미리보기(투표용지)는 키 없이도 표시됩니다.
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 사용 시 카카오 개발자 콘솔의 [플랫폼 ▸ Web]에 배포 도메인을 등록해야 합니다.
# NEXT_PUBLIC_KAKAO_JS_KEY="your-kakao-javascript-key"
